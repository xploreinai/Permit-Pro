# SERVER-ONLY settings for email approvals.
# Enter these in the Vercel dashboard (Project -> Settings -> Environment Variables).
# Do NOT put them in .env.local and NEVER give them a VITE_ prefix:
# VITE_ variables are bundled into the public browser code.

# Supabase: Settings -> API. The service_role key bypasses all database security —
# treat it like a master password. Never paste it in chat, email or git.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Resend (https://resend.com)
RESEND_API_KEY=
# Must be on a domain you verified in Resend, e.g.  Permit Pro <permits@yourdomain.com>
EMAIL_FROM=
# Signing secret of the Resend webhook (starts with whsec_)
RESEND_WEBHOOK_SECRET=

# Public address of the deployed app, no trailing slash
APP_BASE_URL=https://your-app.vercel.app

# Who gets the approval emails (comma-separated for more than one person)
ENGINEERING_APPROVER_EMAILS=
HCC_APPROVER_EMAILS=

# Address that receives "Approved" replies, e.g. abc123.resend.app (Resend -> Emails -> Receiving).
# Leave empty for link-only emails.
INBOUND_REPLY_DOMAIN=
