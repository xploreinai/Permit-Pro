# Supabase (get these from https://supabase.com -> your project -> Settings -> API)
# Note: copy the anon key while it's *revealed* in the dashboard, not while masked -
# a masked key contains bullet characters that break every request.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
